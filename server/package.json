    "stage": "tsx src/cli.ts",
    "postinstall": "npx playwright install chromium"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.2",
    "playwright": "^1.49.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=23.4"
  }
}