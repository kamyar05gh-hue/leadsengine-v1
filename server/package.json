{
  "name": "leadengine-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LeadEngine — GEO/AI-search visibility platform backend (Future Media)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
